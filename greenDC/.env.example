# Copy this file to .env and fill in your own values.

# OpenAlex (only needed by download_documents.py)
OPENALEX_BASE_URL=https://api.openalex.org/works
OPENALEX_API_KEY=
PDF_FOLDER=data/pdfs
OUTPUT_FILE=data/corpus.jsonl

# Ollama (semantic search and AI answers)
OPENAI_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
EMBEDDING_MODEL=qwen3-embedding:0.6b
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=8192
LLM_KEEP_ALIVE=5m

# Elasticsearch / OpenSearch (optional, leave the URL empty to turn it off)
ELASTICSEARCH_BASE_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
